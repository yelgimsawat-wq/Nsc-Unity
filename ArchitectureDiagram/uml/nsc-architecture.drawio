y relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dataflow-e20" value="" style="html=1;rounded=0;strokeColor=#E3E3E3;fontColor=#BDBDBD;fontSize=10;labelBackgroundColor=#141414;fontFamily=Arial;endArrow=open;endFill=0;endSize=10;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=12;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="dataflow-phase" target="dataflow-panels"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dataflow-e21" value="" style="html=1;rounded=0;strokeColor=#E3E3E3;fontColor=#BDBDBD;fontSize=10;labelBackgroundColor=#141414;fontFamily=Arial;endArrow=open;endFill=0;endSize=10;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=12;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="dataflow-scenes" target="dataflow-panels"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="582"/><mxPoint x="250" y="720"/><mxPoint x="905" y="720"/></Array></mxGeometry></mxCell><mxCell id="dataflow-e22" value="" style="html=1;rounded=0;strokeColor=#E3E3E3;fontColor=#BDBDBD;fontSize=10;labelBackgroundColor=#141414;fontFamily=Arial;endArrow=open;endFill=0;endSize=10;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=12;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="dataflow-tutorial" target="dataflow-panels"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="250" y="652"/><mxPoint x="250" y="720"/><mxPoint x="905" y="720"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="gameplay" name="15. พฤติกรรมที่ผู้เล่นเห็น: ลำตัว แขนขา และแมตช์"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1400" pageHeight="896" background="#141414" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="gameplay-status" value="พฤติกรรมที่ผู้เล่นเห็น · ต้องเหมือนเดิมทั้งโค้ดตอนนี้และหลังรีแฟกเตอร์" style="rounded=1;arcSize=50;html=1;whiteSpace=nowrap;align=left;spacingLeft=12;fillColor=#141414;strokeColor=#81C995;fontColor=#81C995;fontFamily=Arial;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="-26" width="396" height="22" as="geometry"/></mxCell><mxCell id="gameplay-g-torso" value="&lt;b&gt;ลำตัว (ทั้งหุ่น)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5C5C5C;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontColor=#BDBDBD;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1320" height="230" as="geometry"/></mxCell><mxCell id="gameplay-g-limb" value="&lt;b&gt;แขนขาแต่ละชิ้น&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5C5C5C;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontColor=#BDBDBD;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="1320" height="240" as="geometry"/></mxCell><mxCell id="gameplay-g-match" value="&lt;b&gt;แมตช์&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#5C5C5C;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontColor=#BDBDBD;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="570" width="1320" height="250" as="geometry"/></mxCell><mxCell id="gameplay-t0" value="" style="ellipse;html=1;fillColor=#E3E3E3;strokeColor=#E3E3E3;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="20" height="20" as="geometry"/></mxCell><mxCell id="gameplay-tStand" value="&lt;b style=&quot;font-size:12px&quot;&gt;Standing&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#BDBDBD&quot; style=&quot;font-size:10px&quot;&gt;ลอยพยุงตัว ดึงลำตัวเข้าหากลางเท้า&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#BDBDBD&quot; style=&quot;font-size:10px&quot;&gt;เดิน กระโดด จับ ต่อย เตะ&lt;/font&gt;" style="rounded=1;arcSize=21;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E3E3E3;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="130" y="107" width="200" height="66" as="geometry"/></mxCell><mxCell id="gameplay-tRag" value="&lt;b style=&quot;font-size:12px&quot;&gt;Ragdoll&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#BDBDBD&quot; style=&quot;font-size:10px&quot;&gt;ล้มตามฟิสิกส์ ลุกเองไม่ได้&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#BDBDBD&quot; style=&quot;font-size:10px&quot;&gt;ทุกคนกด Q ช่วยกันดันตัวขึ้นได้&lt;/font&gt;" style="rounded=1;arcSize=21;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E3E3E3;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="590" y="107" width="170" height="66" as="geometry"/></mxCell><mxCell id="gameplay-l0" value="" style="ellipse;html=1;fillColor=#E3E3E3;strokeColor=#E3E3E3;" vertex="1" parent="1"><mxGeometry x="70" y="410" width="20" height="20" as="geometry"/></mxCell><mxCell id="gameplay-lAtt" value="&lt;b style=&quot;font-size:12px&quot;&gt;ต่ออยู่&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#BDBDBD&quot; style=&quot;font-size:10px&quot;&gt;รับดาเมจ และ regen 2 ต่อวิ&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#BDBDBD&quot; style=&quot;font-size:10px&quot;&gt;หลังไม่โดนตี 7.5 วิ&lt;/font&gt;" style="rounded=1;arcSize=21;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E3E3E3;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="130" y="387" width="160" height="66" as="geometry"/></mxCell><mxCell id="gameplay-lDet" value="&lt;b style=&quot;font-size:12px&quot;&gt;หลุด&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#BDBDBD&quot; style=&quot;font-size:10px&quot;&gt;ไม่รับดาเมจ ขาคลานตามจุดเล็ง แขนนิ่ง&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#BDBDBD&quot; style=&quot;font-size:10px&quot;&gt;ดึงกลับได้หลังหลุด 3 วิ&lt;/font&gt;" style="rounded=1;arcSize=21;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E3E3E3;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="387" width="220" height="66" as="geometry"/></mxCell><mxCell id="gameplay-lPull" value="&lt;b style=&quot;font-size:12px&quot;&gt;กำลังดึงกลับ&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#BDBDBD&quot; style=&quot;font-size:10px&quot;&gt;สปริงดึงเข้า socket เร็วสุด 25 ม./วิ&lt;/font&gt;" style="rounded=1;arcSize=27;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E3E3E3;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="394" width="200" height="52" as="geometry"/></mxCell><mxCell id="gameplay-m0" value="" style="ellipse;html=1;fillColor=#E3E3E3;strokeColor=#E3E3E3;" vertex="1" parent="1"><mxGeometry x="70" y="680" width="20" height="20" as="geometry"/></mxCell><mxCell id="gameplay-mPrep" value="&lt;b style=&quot;font-size:12px&quot;&gt;เตรียม&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#BDBDBD&quot; style=&quot;font-size:10px&quot;&gt;จองแขนขา (co-op) หรือเลือกทีม (PvP)&lt;/font&gt;" style="rounded=1;arcSize=27;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E3E3E3;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="130" y="664" width="210" height="52" as="geometry"/></mxCell><mxCell id="gameplay-mPlay" value="&lt;b style=&quot;font-size:12px&quot;&gt;กำลังเล่น&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#BDBDBD&quot; style=&quot;font-size:10px&quot;&gt;พาร์คัวร์: ตกแมพ = เกิดที่เช็คพอยต์&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#BDBDBD&quot; style=&quot;font-size:10px&quot;&gt;ชิ้นที่หลุดยังหลุด เลือดเท่าเดิม&lt;/font&gt;" style="rounded=1;arcSize=21;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E3E3E3;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="460" y="657" width="190" height="66" as="geometry"/></mxCell><mxCell id="gameplay-mEnd" value="&lt;b style=&quot;font-size:12px&quot;&gt;จบแมตช์&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#BDBDBD&quot; style=&quot;font-size:10px&quot;&gt;หน้าผลลัพธ์ขึ้นทุกเครื่อง แขนขาหยุดรับ input&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#BDBDBD&quot; style=&quot;font-size:10px&quot;&gt;host กดเล่นใหม่หรือออก&lt;/font&gt;" style="rounded=1;arcSize=21;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#E3E3E3;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="657" width="230" height="66" as="geometry"/></mxCell><mxCell id="gameplay-nFall" value="&lt;b&gt;&lt;font color=&quot;#81C995&quot;&gt;Standing → Ragdoll เมื่อ:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;สองขาก้าวพร้อมกันเกิน 0.15 วิ (กฎหลักของเกม)&lt;br&gt;stress ≥ 50 (ชน โดนตี) เว้นแต่มีมือจับของนิ่ง&lt;br&gt;เอียงเกิน 45° ตอนไม่มีเท้าแตะพื้น 0.25 วิ&lt;br&gt;สองเท้าลอยและเสียสมดุล 0.15 วิ หรือลอยทั้งตัว 0.5 วิ&lt;br&gt;(กฎทรงตัวพักไว้ถ้ามีขายัน กำลังเตะ หรือจับของนิ่ง)&lt;br&gt;ขาหลุด หรือโดนหลุมดำของบอส" style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#141414;strokeColor=#81C995;fontColor=#BDBDBD;fontFamily=Arial;fontSize=10;" vertex="1" parent="1"><mxGeometry x="820" y="70" width="280" height="114" as="geometry"/></mxCell><mxCell id="gameplay-nJump" value="&lt;b&gt;&lt;font color=&quot;#81C995&quot;&gt;กระโดด (อยู่ใน Standing):&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Space ขาแรก = hop, ขาที่สองกดภายใน 0.3 วิ = co-op jump&lt;br&gt;ความเร็วขึ้นไม่เกิน 10 ม./วิ พักกฎล้มจากเท้า 1.2 วิ" style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#141414;strokeColor=#81C995;fontColor=#BDBDBD;fontFamily=Arial;fontSize=10;" vertex="1" parent="1"><mxGeometry x="130" y="196" width="310" height="58" as="geometry"/></mxCell><mxCell id="gameplay-nLimb" value="&lt;b&gt;&lt;font color=&quot;#81C995&quot;&gt;ทุกครั้งที่หลุด เพดานเลือดของชิ้นลด 125 (ต่ำสุด 50)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;ขาหลุด → ลำตัวเป็น Ragdoll ทันที" style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#141414;strokeColor=#81C995;fontColor=#BDBDBD;fontFamily=Arial;fontSize=10;" vertex="1" parent="1"><mxGeometry x="480" y="326" width="280" height="44" as="geometry"/></mxCell><mxCell id="gameplay-nMatch" value="&lt;b&gt;&lt;font color=&quot;#81C995&quot;&gt;เช็คแพ้เป็นรอบ: บอสทุก 1 วิ PvP ทุก 0.25 วิ&lt;/font&gt;&lt;/b&gt;&lt;br&gt;ต่อชิ้นกลับทันก่อนรอบเช็ค = ยังไม่แพ้&lt;br&gt;พาร์คัวร์ไม่มีแพ้ จบที่เส้นชัยพร้อมเวลาและความสูง" style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#141414;strokeColor=#81C995;fontColor=#BDBDBD;fontFamily=Arial;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1085" y="661" width="260" height="58" as="geometry"/></mxCell><mxCell id="gameplay-e0" value="" style="html=1;rounded=0;strokeColor=#E3E3E3;fontColor=#BDBDBD;fontSize=10;labelBackgroundColor=#141414;fontFamily=Arial;endArrow=open;endFill=0;endSize=10;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=12;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="gameplay-t0" target="gameplay-tStand"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="gameplay-e1" value="" style="html=1;rounded=0;strokeColor=#E3E3E3;fontColor=#BDBDBD;fontSize=10;labelBackgroundColor=#141414;fontFamily=Arial;endArrow=open;endFill=0;endSize=10;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=12;exitX=1.0000;exitY=0.2273;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.2273;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="gameplay-tStand" target="gameplay-tRag"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="gameplay-l1" value="ล้ม (เงื่อนไขในโน้ต)" style="text;html=1;align=center;verticalAlign=middle;