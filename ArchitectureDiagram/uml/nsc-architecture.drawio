ry y="68" width="260" height="38" as="geometry"/></mxCell><mxCell id="damage-PunchBag" value="&amp;lt;&amp;lt;NetworkBehaviour&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;PunchBag&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8AB4F8&quot; style=&quot;font-size:10px&quot;&gt;{มีอยู่แล้ว · ปรับ}&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=49;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#141414;swimlaneFillColor=#141414;strokeColor=#E3E3E3;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1300" y="680" width="390" height="103" as="geometry"/></mxCell><mxCell id="damage-PunchBag-a" value="- rb : Rigidbody" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=0;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="damage-PunchBag"><mxGeometry y="49" width="390" height="23" as="geometry"/></mxCell><mxCell id="damage-PunchBag-l" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#E3E3E3;" vertex="1" parent="damage-PunchBag"><mxGeometry y="72" width="390" height="8" as="geometry"/></mxCell><mxCell id="damage-PunchBag-m" value="+ ServerApplyDamage(info : DamageInfo) : bool {เดิม: ServerTakeDamage}" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=0;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="damage-PunchBag"><mxGeometry y="80" width="390" height="23" as="geometry"/></mxCell><mxCell id="damage-nFormula" value="&lt;b&gt;&lt;font color=&quot;#81C995&quot;&gt;สูตรดาเมจเดิม (ย้ายค่าเข้า StrikeTuning):&lt;/font&gt;&lt;/b&gt;&lt;br&gt;หมัดและเตะนับเมื่อความเร็วพีค ≥ 8 ม./วิ&lt;br&gt;ดาเมจ = min(ความเร็วพีค × 0.6 หมัด หรือ 1.2 เตะ, 60) หนึ่งหมัดหนึ่งครั้ง&lt;br&gt;ชนหุ่นตัวเอง ทีมเดียวกัน หรือชิ้นที่หลุด = ไม่คิดดาเมจ&lt;br&gt;ชนกำแพงแรงๆ = จบหมัด แต่ยังไม่ล็อกดาเมจ" style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#141414;strokeColor=#81C995;fontColor=#BDBDBD;fontFamily=Arial;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="360" height="86" as="geometry"/></mxCell><mxCell id="damage-nVerify" value="&lt;b&gt;&lt;font color=&quot;#F2B84B&quot;&gt;ต้องยืนยันใน Play Mode ก่อนย้าย:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;แขนขาใน PvP ตอนนี้มีตัวส่งดาเมจ 2 ตัวที่สูตรต่างกัน&lt;br&gt;และ PhysicsDamageSender ไม่เช็คเฟสของแมตช์&lt;br&gt;วัดดาเมจต่อหมัดที่ผู้เล่นเจอจริง แล้วตั้ง StrikeTuning ให้เท่ากัน&lt;br&gt;GameplayGate กันดาเมจนอก Playing: ต่างเฉพาะกรณีขอบ" style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#141414;strokeColor=#F2B84B;fontColor=#BDBDBD;fontFamily=Arial;fontSize=10;" vertex="1" parent="1"><mxGeometry x="420" y="850" width="320" height="86" as="geometry"/></mxCell><mxCell id="damage-e0" value="" style="html=1;rounded=0;strokeColor=#E3E3E3;fontColor=#BDBDBD;fontSize=10;labelBackgroundColor=#141414;fontFamily=Arial;endArrow=open;endFill=0;endSize=10;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=12;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.3581;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="damage-LimbStrike" target="damage-StrikeTuning"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="damage-e1" value="" style="html=1;rounded=0;strokeColor=#E3E3E3;fontColor=#BDBDBD;fontSize=10;labelBackgroundColor=#141414;fontFamily=Arial;