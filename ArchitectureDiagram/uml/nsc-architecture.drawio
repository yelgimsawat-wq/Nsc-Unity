uot;&gt;{เดิม: TorsoMovement}&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=49;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#141414;swimlaneFillColor=#141414;strokeColor=#E3E3E3;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="94" width="260" height="118" as="geometry"/></mxCell><mxCell id="robot-core-TorsoBalance-a" value="- state : NetworkVariable&amp;lt;TorsoState&amp;gt;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=0;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="robot-core-TorsoBalance"><mxGeometry y="49" width="260" height="23" as="geometry"/></mxCell><mxCell id="robot-core-TorsoBalance-l" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#E3E3E3;" vertex="1" parent="robot-core-TorsoBalance"><mxGeometry y="72" width="260" height="8" as="geometry"/></mxCell><mxCell id="robot-core-TorsoBalance-m" value="+ ServerKnockDown(reason : FallReason) : void&lt;br&gt;+ ServerResetForRespawn() : void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=0;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="robot-core-TorsoBalance"><mxGeometry y="80" width="260" height="38" as="geometry"/></mxCell><mxCell id="robot-core-LimbController" value="&amp;lt;&amp;lt;NetworkBehaviour&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;&lt;i&gt;LimbController&lt;/i&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8AB4F8&quot; style=&quot;font-size:10px&quot;&gt;{ใหม่}&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=49;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#141414;swimlaneFillColor=#141414;strokeColor=#E3E3E3;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="640" width="240" height="118" as="geometry"/></mxCell><mxCell id="robot-core-LimbController-a" value="# limb : RobotLimb&lt;br&gt;# body : Rigidbody" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=0;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="robot-core-LimbController"><mxGeometry y="49" width="240" height="38" as="geometry"/></mxCell><mxCell id="robot-core-LimbController-l" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#E3E3E3;" vertex="1" parent="robot-core-LimbController"><mxGeometry y="87" width="240" height="8" as="geometry"/></mxCell><mxCell id="robot-core-LimbController-m" value="+ ServerResetForRespawn() : void {abstract}" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=0;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="robot-core-LimbController"><mxGeometry y="95" width="240" height="23" as="geometry"/></mxCell><mxCell id="robot-core-nLimb" value="&lt;b&gt;&lt;font color=&quot;#81C995&quot;&gt;กติการะดับชิ้น เหมือนโค้ดตอนนี้ (server):&lt;/font&gt;&lt;/b&gt;&lt;br&gt;ชิ้นที่หลุดไม่รับดาเมจ และไม่มีเอฟเฟคโดนตี&lt;br&gt;Hp = 0 หรือโดนท่าไม้ตายบอส → หลุด + เพดานเลือดลด&lt;br&gt;ต่อกลับ → เลือดเต็มตามเพดานปัจจุบัน&lt;br&gt;ทุกเครื่อง: ยิง StateChanged(this)" style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#141414;strokeColor=#81C995;fontColor=#BDBDBD;fontFamily=Arial;fontSize=10;" vertex="1" parent="1"><mxGeometry x="130" y="385" width="280" height="86" as="geometry"/></mxCell><mxCell id="robot-core-nRelay" value="&lt;b&gt;&lt;font color=&quot;#81C995&quot;&gt;เหมือน PvP ตอนนี้:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;ลำตัวไม่มีเลือดของตัวเอง&lt;br&gt;ดาเมจที่ลำตัวลงชิ้นที่ใกล้จุดปะทะที่สุด&lt;br&gt;และยังต่ออยู่ (ไม่หารให้ทุกชิ้น)" style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#141414;strokeColor=#81C995;fontColor=#BDBDBD;fontFamily=Arial;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1300" y="117" width="200" height="72" as="geometry"/></mxCell><mxCell id="robot-core-nDetach" value="&lt;b&gt;&lt;font color=&quot;#81C995&quot;&gt;หลุดและดึงกลับแบบเดิม:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;หลุด = ทำลาย joint อย่างเดียว ตัวชิ้นและฟิสิกส์ยังอยู่&lt;br&gt;ขาที่หลุดยังคลานตามจุดเล็ง แขนที่หลุดนิ่ง&lt;br&gt;กด R ค้างได้หลังหลุด 3 วิ ต่อเมื่อห่าง socket ≤ 2 ม." style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#141414;strokeColor=#81C995;fontColor=#BDBDBD;fontFamily=Arial;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="270" height="72" as="geometry"/></mxCell><mxCell id="robot-core-nHealth" value="&lt;b&gt;&lt;font color=&quot;#81C995&quot;&gt;ค่าจาก prefab ที่ฉากเกมใช้จริง:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;เลือดเริ่ม 500 หลุดแต่ละครั้งเพดานลด 125 (ต่ำสุด 50)&lt;br&gt;ไม่โดนตี 7.5 วิ แล้ว regen 2 ต่อวิ ไม่เกินเพดาน&lt;br&gt;โดนตีแล้วชิ้นนั้นกระเด็น (แรง = ดาเมจ × 2)" style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#141414;strokeColor=#81C995;fontColor=#BDBDBD;fontFamily=Arial;fontSize=10;" vertex="1" parent="1"><mxGeometry x="680" y="856" width="280" height="72" as="geometry"/></mxCell><mxCell id="robot-core-e0" value="" style="html=1;rounded=0;strokeColor=#E3E3E3;fontColor=#BDBDBD;fontSize=10;labelBackgroundColor=#141414;fontFamily=Arial;startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=12;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="robot-core-Robot" target="robot-core-TorsoBalance"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="robot-core-l0" value="1" style="text;html=1;align=center;verticalAlign=middle;fontColor=#BDBDBD;fontSize=10;fontFamily=Arial;strokeColor=none;fillColor=none;labelBackgroundColor=#141414;align=center;" vertex="1" parent="1"><mxGeometry x="354" y="138" width="16" height="14" as="geometry"/></mxCell><mxCell id="robot-core-e1" value="" style="html=1;rounded=0;strokeColor=#E3E3E3;fontColor=#BDBDBD;fontSize=10;labelBackgroundColor=#141414;fontFamily=Arial;startArrow=diamondThin;startFill=1;startSize=16;endArrow=none;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=12;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="robot-core-Robot" target="robot-core-RobotLimb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="robot-core-l1" value="4" style="text;html=1;align=center;verticalAlign=middle;fontColor=#BDBDBD;fontSize=10;fontFamily=Arial;strokeColor=none;fillColor=none;labelBackgroundColor=#141414;align=center;" vertex="1" parent="1"><mxGeometry x="564" y="300" width="16" height="14" as="geometry"/></mxCell><mxCell id="robot-core-e2" value="" style="html=1;rounded=0;strokeColor=#E3E3E3;