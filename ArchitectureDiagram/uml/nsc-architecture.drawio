) : void&lt;br&gt;+ CanDealDamage() : bool&lt;br&gt;+ PeakSpeed() : float" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=0;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="limb-control-KickAbility"><mxGeometry y="110" width="240" height="68" as="geometry"/></mxCell><mxCell id="limb-control-IStrikeSource" value="&amp;lt;&amp;lt;Interface&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;IStrikeSource&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8AB4F8&quot; style=&quot;font-size:10px&quot;&gt;{ใหม่}&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=49;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#141414;swimlaneFillColor=#141414;strokeColor=#E3E3E3;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="1010" width="160" height="148" as="geometry"/></mxCell><mxCell id="limb-control-IStrikeSource-a" value="" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=0;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="limb-control-IStrikeSource"><mxGeometry y="49" width="160" height="8" as="geometry"/></mxCell><mxCell id="limb-control-IStrikeSource-l" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#E3E3E3;" vertex="1" parent="limb-control-IStrikeSource"><mxGeometry y="57" width="160" height="8" as="geometry"/></mxCell><mxCell id="limb-control-IStrikeSource-m" value="+ CanDealDamage() : bool&lt;br&gt;+ PeakSpeed() : float&lt;br&gt;+ Source() : DamageSource&lt;br&gt;+ OnStrikeLanded() : void&lt;br&gt;+ OnStrikeBlocked() : void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=0;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="limb-control-IStrikeSource"><mxGeometry y="65" width="160" height="83" as="geometry"/></mxCell><mxCell id="limb-control-LimbStrike" value="&lt;b&gt;LimbStrike&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8AB4F8&quot; style=&quot;font-size:10px&quot;&gt;{เดิม: PhysicsDamageSender + PvpDamageSender}&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=37;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#141414;swimlaneFillColor=#141414;strokeColor=#E3E3E3;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="1020" width="260" height="121" as="geometry"/></mxCell><mxCell id="limb-control-LimbStrike-a" value="- source : IStrikeSource&lt;br&gt;- tuning : StrikeTuning" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=0;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="limb-control-LimbStrike"><mxGeometry y="37" width="260" height="38" as="geometry"/></mxCell><mxCell id="limb-control-LimbStrike-l" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#E3E3E3;" vertex="1" parent="limb-control-LimbStrike"><mxGeometry y="75" width="260" height="8" as="geometry"/></mxCell><mxCell id="limb-control-LimbStrike-m" value="- OnCollisionEnter(c : Collision) : void&lt;br&gt;- BuildDamageInfo(c : Collision) : DamageInfo" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=0;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="limb-control-LimbStrike"><mxGeometry y="83" width="260" height="38" as="geometry"/></mxCell><mxCell id="limb-control-nMode" value="&lt;b&gt;&lt;font color=&quot;#81C995&quot;&gt;ขาที่หลุดคิดแบบเดิม:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;ResolveMode() ครั้งเดียวต่อ tick จาก attachment, ท่าเตะ,&lt;br&gt;ลำตัวล้มไหม และคำสั่งล่าสุด&lt;br&gt;ขาที่หลุด: canSupport = false&lt;br&gt;แต่ grounded และ balanced ยังคิดตามฟิสิกส์" style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#141414;strokeColor=#81C995;fontColor=#BDBDBD;fontFamily=Arial;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="664" width="300" height="86" as="geometry"/></mxCell><mxCell id="limb-control-nStuck" value="&lt;b&gt;&lt;font color=&quot;#F2B84B&quot;&gt;ต้องตัดสินก่อนเปลี่ยน: แฟล็กก้าวค้าง&lt;/font&gt;&lt;/b&gt;&lt;br&gt;ตอนนี้ถ้าขาหลุดตอนผู้เล่นกดคลิกซ้ายค้างอยู่&lt;br&gt;stepping ของขานั้นค้าง และยังนับในกฎสองขาก้าวพร้อมกัน&lt;br&gt;ที่เสนอเก็บแบบเดิมไว้ก่อน ล้างตอนหลุดเมื่อทีมยืนยันว่าเป็นบั๊ก" style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#141414;strokeColor=#F2B84B;fontColor=#BDBDBD;fontFamily=Arial;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1160" y="500" width="310" height="72" as="geometry"/></mxCell><mxCell id="limb-control-nRpc" value="&lt;b&gt;&lt;font color=&quot;#81C995&quot;&gt;ผู้เล่นปกติไม่เห็นความต่าง:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;RPC ทุกตัวเป็น owner-only ตัวรับแค่ตรวจค่าแล้วเก็บคำสั่ง&lt;br&gt;ส่งเมื่อเป้าขยับเกินเกณฑ์ ฟิสิกส์รันบน server ใน FixedUpdate&lt;br&gt;ไม่มี client prediction เหมือนตอนนี้" style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#141414;strokeColor=#81C995;fontColor=#BDBDBD;fontFamily=Arial;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1190" y="70" width="310" height="72" as="geometry"/></mxCell><mxCell id="limb-control-nControls" value="&lt;b&gt;&lt;font color=&quot;#81C995&quot;&gt;ปุ่มเหมือนเดิมทุกปุ่ม:&lt;/font&gt;&lt;/b&gt;&lt;br&gt;เมาส์ = เล็ง (แขนขาในเครื่องเดียวกันใช้จุดเล็งร่วม)&lt;br&gt;ล้อ = ระยะยื่นมือหรือระยะก้าว&lt;br&gt;คลิกซ้าย: มือ = ต่อย, เท้า = ค้างเพื่อก้าว ปล่อยเพื่อวาง&lt;br&gt;F ค้าง = จับ, Space = โดด, Shift ค้างแล้วปล่อย = เตะ&lt;br&gt;Q = ลุกตอนล้ม, R ค้าง = ดึงชิ้นที่หลุดกลับ&lt;br&gt;คลิกขวาค้าง = หมุนกล้อง" style="shape=note;size=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fillColor=#141414;strokeColor=#81C995;fontColor=#BDBDBD;fontFamily=Arial;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="1000" width="280" height="114" as="geometry"/></mxCell><mxCell id="limb-control-e0" value="" style="html=1;rounded=0;strokeColor=#E3E3E3;fontColor=#BDBDBD;fontSize=10;labelBackgroundColor=#141414;fontFamily=Arial;endArrow=open;endFill=0;endSize=10;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=12;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="limb-control-ArmInput" target="limb-control-LocalAim"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="limb-control-e1" value="" style="html=1;rounded=0;strokeColor=#E3E3E3;fontColor=#BDBDBD;fontSize=10;labelBackgroundColor=#141414;fontFamily=Arial;endArrow=open;endFill=0;endSize=10;edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=12;exitX=0.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;e