t-a" value="- isAttached : NetworkVariable&amp;lt;bool&amp;gt;&lt;br&gt;- socket : Rigidbody&lt;br&gt;- savedJoint : SavedJointSettings&lt;br&gt;- reconnectCooldown : float = 3&lt;br&gt;- reconnectDistance : float = 2&lt;br&gt;+ IsAttached : bool&lt;br&gt;+ AttachmentChanged : event" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=0;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="robot-core-LimbAttachment"><mxGeometry y="49" width="220" height="113" as="geometry"/></mxCell><mxCell id="robot-core-LimbAttachment-l" value="" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#E3E3E3;" vertex="1" parent="robot-core-LimbAttachment"><mxGeometry y="162" width="220" height="8" as="geometry"/></mxCell><mxCell id="robot-core-LimbAttachment-m" value="+ ServerDetach() : void&lt;br&gt;+ RequestPullBackRpc(held : bool) : void&lt;br&gt;- ServerReconnect() : void" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=6;spacingRight=4;spacingTop=0;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=nowrap;html=1;fontColor=#F2F2F2;fontFamily=Arial;fontSize=11;" vertex="1" parent="robot-core-LimbAttachment"><mxGeometry y="170" width="220" height="53" as="geometry"/></mxCell><mxCell id="robot-core-SavedJointSettings" value="&amp;lt;&amp;lt;Struct&amp;gt;&amp;gt;&lt;br&gt;&lt;b&gt;SavedJointSettings&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#8AB4F8&quot; style=&quot;font-size:10px&quot;&gt;{เดิม: SavedConfigurableJointSettings}&lt;/font&gt;" style="swimlane;fontStyle=0;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=49;horizontalStack=0;resizeParent=1;resizeParentMax=0;